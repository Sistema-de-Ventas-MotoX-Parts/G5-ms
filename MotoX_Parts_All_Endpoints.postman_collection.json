		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "Login (Admin Seeder)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@admin\",\n    \"contrasenia\": \"Admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Iniciar sesión con el usuario Administrador creado por la semilla (seeder)."
					},
					"response": []
				},
				{
					"name": "Registro Público (Rol USER por defecto)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan Pérez\",\n    \"email\": \"juan@example.com\",\n    \"contrasenia\": \"Juan12345\"\n}"
